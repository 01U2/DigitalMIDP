<Window x:Class="DigitalMIDP.ManifestRunner.SetupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Runner — Autodesk setup" Width="490" SizeToContent="Height" WindowStartupLocation="CenterScreen" Background="#F0F0F0">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3498DB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2980B9"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#BDC3C7"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Margin="18" Padding="14" Background="White" BorderBrush="#D0DCE8" BorderThickness="1" CornerRadius="4">
    <StackPanel>
        <TextBlock TextWrapping="Wrap" Text="Enter your company's public APS desktop application Client ID. The application must have this callback URL registered:" />
        <TextBlock Text="{Binding RedirectUri}" Margin="0,6,0,12" />
        <TextBlock Text="Client ID" />
        <TextBox Text="{Binding ClientId, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Foreground="Firebrick" TextWrapping="Wrap" Text="{Binding ErrorMessage}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Save" Command="{Binding SaveCommand}" IsDefault="True" Width="80" />
            <Button Content="Cancel" IsCancel="True" Width="80" />
        </StackPanel>
    </StackPanel>
    </Border>
</Window>
