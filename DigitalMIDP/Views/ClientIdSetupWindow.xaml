<Window x:Class="DigitalMIDP.Views.ClientIdSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Digital MIDP - Autodesk Setup"
        Icon="/DigitalMIDP;component/Assets/Icons/icon.ico"
        Width="520" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="20">
        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Connect to your company's Autodesk application" />
        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap"
                   Text="Enter the Client ID of the Autodesk Platform Services (APS) application registered by your company. Ask your administrator if you do not have it." />
        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap">
            <Run Text="The APS application must be a Desktop/Native app with this callback URL registered:" />
            <LineBreak />
            <Run FontFamily="Consolas" Text="{Binding RedirectUri, Mode=OneWay}" />
        </TextBlock>
        <TextBlock Margin="0,16,0,4" Text="Client ID" FontWeight="SemiBold" />
        <TextBox Text="{Binding ClientId, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" Padding="4" />
        <TextBlock Margin="0,6,0,0" Foreground="Firebrick" TextWrapping="Wrap" Text="{Binding ErrorMessage}" />
        <StackPanel Margin="0,16,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Save" Width="90" Margin="0,0,8,0" IsDefault="True" Command="{Binding SaveCommand}" />
            <Button Content="Exit" Width="90" IsCancel="True" Command="{Binding CancelCommand}" />
        </StackPanel>
    </StackPanel>
</Window>
