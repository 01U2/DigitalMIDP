<Window x:Class="DigitalMIDP.Views.CreateDeliverableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:DigitalMIDP.Converters"
        mc:Ignorable="d"
        Title="New Deliverable"
        Height="620" Width="560"
         Icon="/DigitalMIDP;component/Assets/Icons/icon.ico"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#F0F0F0">

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBooleanConverter x:Key="InverseBool"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
        <converters:NullToVisibilityConverter x:Key="NullToVis"/>
        <converters:EqualityToVisibilityConverter x:Key="StepToVis"/>

        <!-- Shared look for a labelled attribute input, used by both field lists in step 3. -->
        <DataTemplate x:Key="AttributeFieldTemplate">
            <StackPanel Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" Foreground="#2C3E50"/>
                    <TextBlock Text=" *" FontWeight="SemiBold" Foreground="#E74C3C"
                               Visibility="{Binding Optional, Converter={StaticResource InverseBoolToVis}}"/>
                </StackPanel>

                <!-- Hint carries the field's description plus ACC's own length rule ("2-6
                     characters"), so the constraint is visible before the value is typed. -->
                <TextBlock Text="{Binding Hint}" FontSize="11" Foreground="#7F8C8D" Margin="0,2,0,4"
                           TextWrapping="Wrap"
                           Visibility="{Binding Hint, Converter={StaticResource NullToVis}}"/>

                <ComboBox ItemsSource="{Binding Options}"
                          SelectedValue="{Binding Value, Mode=TwoWay}" SelectedValuePath="Value"
                          IsEnabled="{Binding IsEditable}"
                          IsEditable="False" Padding="6,4"
                          Visibility="{Binding IsDropdown, Converter={StaticResource BoolToVis}}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Value}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Description, StringFormat=' — {0}'}" Foreground="#7F8C8D"
                                           Visibility="{Binding Description, Converter={StaticResource NullToVis}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBox Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="{Binding IsComputed}"
                         Padding="6,4"
                         Visibility="{Binding IsFreeText, Converter={StaticResource BoolToVis}}">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Background" Value="White"/>
                            <!-- Computed fields, if present, are shown as read-only derived output. -->
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsComputed}" Value="True">
                                    <Setter Property="Background" Value="#ECF0F1"/>
                                    <Setter Property="Foreground" Value="#566573"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </StackPanel>
        </DataTemplate>

        <!-- Each document gets its own Deliverable Title (Description) input. -->
        <DataTemplate x:Key="DeliverableItemTemplate">
            <Border BorderBrush="#D5DBDB" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,10" Background="#FBFCFC">
                <StackPanel>
                    <TextBlock Text="{Binding Index, StringFormat='Document {0}'}" FontWeight="SemiBold"
                               Foreground="#2C3E50" Margin="0,0,0,8"/>

                    <ContentControl Content="{Binding DeliverableTitleField}"
                                    ContentTemplate="{StaticResource AttributeFieldTemplate}"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="New Deliverable" FontSize="18" FontWeight="Bold" Foreground="#2C3E50"/>
            <TextBlock Text="{Binding StepTitle}" FontSize="12" Foreground="#7F8C8D" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Steps -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      IsEnabled="{Binding IsConfigured}">
            <Grid>
                <!-- Step 1: type and discipline -->
                <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource StepToVis}, ConverterParameter=1}">
                    <TextBlock Text="Deliverable type" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding DeliverableTypes}"
                              SelectedItem="{Binding SelectedDeliverableType, Mode=TwoWay}"
                              Padding="6,4" Margin="0,0,0,16">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Value}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Description, StringFormat=' — {0}'}" Foreground="#7F8C8D"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="Discipline" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Disciplines}"
                              SelectedItem="{Binding SelectedDiscipline, Mode=TwoWay}"
                              Padding="6,4" Margin="0,0,0,16">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding ExpectedFolderName}" FontWeight="SemiBold"/>
                                    <TextBlock Text=" (folder will be created)" Foreground="#E67E22" FontSize="11"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding Exists, Converter={StaticResource InverseBoolToVis}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="How many documents?" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,6"/>

                    <!-- Quantity stepper: minus/plus buttons flank a still-editable text box, so a
                         small change is one click and an exact large value is still one keystroke away.
                         Centered in its own row, unlike the fields above, since it reads as a compact
                         control rather than a form field. -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="−" Width="34" Height="34" FontSize="16" FontWeight="Bold" Padding="0"
                                Command="{Binding DecrementQuantityCommand}"
                                IsEnabled="{Binding CanDecrementQuantity}"/>
                        <TextBox Text="{Binding QuantityText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Width="56" Height="34" Padding="0" Margin="6,0"
                                 TextAlignment="Center" VerticalContentAlignment="Center" FontWeight="SemiBold"/>
                        <Button Content="+" Width="34" Height="34" FontSize="16" FontWeight="Bold" Padding="0"
                                Command="{Binding IncrementQuantityCommand}"
                                IsEnabled="{Binding CanIncrementQuantity}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Step 2: template -->
                <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource StepToVis}, ConverterParameter=2}">
                    <TextBlock Text="Template" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,8"/>

                    <ListBox ItemsSource="{Binding Templates}"
                             SelectedItem="{Binding SelectedTemplate, Mode=TwoWay}"
                             MinHeight="200" BorderBrush="#BDC3C7">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="#2C3E50"/>
                                    <TextBlock Text="{Binding Name}" FontSize="11" Foreground="#7F8C8D"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <!-- Step 3: number segments and metadata -->
                <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource StepToVis}, ConverterParameter=3}">
                    <TextBlock Text="Document number" FontWeight="SemiBold" FontSize="14" Foreground="#2C3E50"
                               Margin="0,0,0,10"/>

                    <ItemsControl ItemsSource="{Binding NumberFields}"
                                  ItemTemplate="{StaticResource AttributeFieldTemplate}"/>

                    <Separator Margin="0,6,0,14"/>

                    <TextBlock FontWeight="SemiBold" FontSize="14" Foreground="#2C3E50" Margin="0,0,0,10">
                        <Run Text="Attributes"/>
                        <Run Text=" (shared by all documents)" FontWeight="Normal" FontSize="11" Foreground="#7F8C8D"/>
                    </TextBlock>

                    <ItemsControl ItemsSource="{Binding SharedMetadataFields}"
                                  ItemTemplate="{StaticResource AttributeFieldTemplate}"/>

                    <Separator Margin="0,6,0,14"/>

                    <TextBlock Text="Deliverable Titles" FontWeight="SemiBold" FontSize="14" Foreground="#2C3E50"
                               Margin="0,0,0,10"/>

                    <ItemsControl ItemsSource="{Binding DeliverableItems}"
                                  ItemTemplate="{StaticResource DeliverableItemTemplate}"/>
                </StackPanel>

                <!-- Step 4: review -->
                <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource StepToVis}, ConverterParameter=4}">
                    <Border Background="White" BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="4" Padding="15">
                        <StackPanel>
                            <TextBlock Text="Documents to create" FontSize="11" Foreground="#7F8C8D"
                                       Visibility="{Binding IsBatch, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="{Binding Quantity}" FontSize="18" FontWeight="Bold"
                                       Foreground="#2C3E50" Margin="0,2,0,12"
                                       Visibility="{Binding IsBatch, Converter={StaticResource BoolToVis}}"/>

                            <!-- Stacked vertically, one number per line: side by side they run past
                                 the window's width once the naming convention has several segments. -->
                            <TextBlock Text="Document number" FontSize="11" Foreground="#7F8C8D"
                                       Visibility="{Binding IsBatch, Converter={StaticResource InverseBoolToVis}}"/>
                            <TextBlock Text="{Binding PreviewDocumentNumber}" FontSize="16" FontWeight="Bold"
                                       Foreground="#2C3E50" TextWrapping="Wrap" Margin="0,2,0,12"
                                       Visibility="{Binding IsBatch, Converter={StaticResource InverseBoolToVis}}"/>

                            <StackPanel Visibility="{Binding IsBatch, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                                <TextBlock Text="First document number" FontSize="11" Foreground="#7F8C8D"/>
                                <TextBlock Text="{Binding PreviewDocumentNumber}" FontSize="16" FontWeight="Bold"
                                           Foreground="#2C3E50" TextWrapping="Wrap" Margin="0,2,0,8"/>

                                <TextBlock Text="Last document number" FontSize="11" Foreground="#7F8C8D"/>
                                <TextBlock Text="{Binding PreviewLastDocumentNumber}" FontSize="16" FontWeight="Bold"
                                           Foreground="#2C3E50" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>

                            <TextBlock Text="File name" FontSize="11" Foreground="#7F8C8D"
                                       Visibility="{Binding IsBatch, Converter={StaticResource InverseBoolToVis}}"/>
                            <TextBlock Text="{Binding PreviewFileName}" FontSize="13" Foreground="#2C3E50"
                                       TextWrapping="Wrap" Margin="0,2,0,12"
                                       Visibility="{Binding IsBatch, Converter={StaticResource InverseBoolToVis}}"/>

                            <TextBlock Text="Destination" FontSize="11" Foreground="#7F8C8D"/>
                            <TextBlock Text="{Binding PreviewDestination}" FontSize="13" Foreground="#2C3E50"
                                       TextWrapping="Wrap" Margin="0,2,0,0"/>
                            <TextBlock Text="This folder will be created."
                                       FontSize="11" Foreground="#E67E22" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding DestinationFolderWillBeCreated, Converter={StaticResource BoolToVis}}"/>

                            <TextBlock Text="Template" FontSize="11" Foreground="#7F8C8D" Margin="0,12,0,0"/>
                            <TextBlock Text="{Binding SelectedTemplate.Name}" FontSize="13" Foreground="#2C3E50"
                                       TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Status area. Only ever shows the current step's own busy state (loading configuration,
             allocating the preview number) or a validation error - the actual creation, and its
             success/failure, happens after this window has already closed, so there is nothing to
             report here about that. -->
        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <Border Background="#EAF2F8" Padding="10" CornerRadius="4"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{Binding BusyMessage}" Foreground="#2980B9" FontSize="12" TextWrapping="Wrap"/>
                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,6,0,0" Background="Transparent"
                                 BorderThickness="0" Foreground="#3498DB"/>
                </StackPanel>
            </Border>

            <Border Background="#FADBD8" Padding="10" CornerRadius="4" Margin="0,6,0,0"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVis}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#C0392B" FontSize="12" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <!-- Navigation -->
        <Grid Grid.Row="3" Margin="0,15,0,0">
            <Button Content="Back" HorizontalAlignment="Left" Padding="15,8"
                    Command="{Binding BackCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                    Visibility="{Binding ShowBack, Converter={StaticResource BoolToVis}}"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Padding="15,8" Margin="0,0,10,0"
                        Click="CancelButton_Click"/>

                <Button Content="Next" Padding="15,8"
                        Background="#3498DB" Foreground="White" BorderThickness="0"
                        Command="{Binding NextCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                        Visibility="{Binding ShowNext, Converter={StaticResource BoolToVis}}"/>

                <!-- Clicking this closes the window immediately (see CreateDeliverableWindow's
                     constructor) - it does not wait for anything to be created. -->
                <Button Content="{Binding CreateButtonLabel}" Padding="15,8"
                        Background="#27AE60" Foreground="White" BorderThickness="0"
                        Command="{Binding CreateCommand}"
                        IsEnabled="{Binding CanCreate}"
                        Visibility="{Binding ShowCreate, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
