<Window x:Class="DigitalMIDP.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:DigitalMIDP.Converters"
        mc:Ignorable="d"
        Title="Digital MIDP - APS File Browser" Height="700" Width="1200"
         Icon="/DigitalMIDP;component/Assets/Icons/icon.ico"
        Background="#F0F0F0">
    
    <Window.Resources>
        <!-- Value Converters -->
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBooleanConverter x:Key="InverseBool"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
        <converters:NullToVisibilityConverter x:Key="NullToVis"/>
        <converters:CustomAttributeValueConverter x:Key="CustomAttrValue"/>
        <converters:SyncStatusToBrushConverter x:Key="SyncStatusToBrush"/>
        <converters:SyncStatusToTextConverter x:Key="SyncStatusToText"/>
        <converters:SyncedProjectToTooltipConverter x:Key="SyncedProjectToTooltip"/>
        <converters:LifecycleStageToTextConverter x:Key="StageToText"/>
        <converters:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVis"/>
        
        <!-- Styles -->
        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3498DB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2980B9"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#BDC3C7"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#E74C3C"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C0392B"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- DataGridCell style for vertical alignment -->
        <Style TargetType="DataGridCell">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0"/>
            <Style.Triggers>
                <!-- Keep selected rows highlighted specifically WHILE the DataGrid's context menu is
                     open - WPF's default "inactive selection" brush (much paler than the active one)
                     kicks in the moment the DataGrid loses keyboard focus to the popup, which
                     otherwise makes a multi-selection look like it disappeared on right-click. Scoped
                     to ContextMenu.IsOpen (not IsSelected alone) so clicking away to something else
                     entirely still fades the selection normally, as expected. -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsSelected}" Value="True"/>
                        <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=ContextMenu.IsOpen}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{x:Static SystemColors.HighlightBrush}"/>
                    <Setter Property="Foreground" Value="{x:Static SystemColors.HighlightTextBrush}"/>
                    <Setter Property="BorderBrush" Value="{x:Static SystemColors.HighlightBrush}"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        
        <!-- DataGrid Column Visibility Converter Proxy -->
        <FrameworkElement x:Key="DataContextProxy" DataContext="{Binding}"/>

        <!-- Shared by every filterable column's header - Title, Stage, and every dynamic custom
             attribute column alike. A DataGridColumn's Header is set to the matching
             AttributeFilterViewModel itself (not a plain string), so every binding below resolves
             directly against that ViewModel regardless of which column is using this template. -->
        <DataTemplate x:Key="FilterableColumnHeaderTemplate">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" FontWeight="SemiBold"/>

                <!-- A plain Border (not part of any control template) carries the "filter active"
                     colour, so the indicator is guaranteed to render exactly as bound - unlike
                     setting Background/Foreground directly on the ToggleButton, whose default control
                     template can render its own chrome over those in some themes. The border is
                     grey/transparent normally and turns solid blue the moment a value is unchecked,
                     with white text/icon on top - which of the two people notice first (the colour
                     block or the icon flipping to white) doesn't matter, both change together. -->
                <Border Margin="4,0,0,0" CornerRadius="3" Padding="4,2">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter Property="Background" Value="#3498DB"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <ToggleButton Padding="0" Background="Transparent" BorderThickness="0"
                                  IsChecked="{Binding IsPopupOpen, Mode=TwoWay}"
                                  ToolTip="Filter this column">
                        <ToggleButton.Content>
                            <!-- Segoe MDL2 Assets is Windows' built-in icon font (ships with Win10/11);
                                 E71C is its funnel/filter glyph. Using it instead of an emoji avoids
                                 bundling an image asset and gives a real filter icon rather than the
                                 closest-looking emoji, which is how the wastebasket ended up here. -->
                            <TextBlock Text="&#xE71C;" FontFamily="Segoe MDL2 Assets" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#7F8C8D"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </ToggleButton.Content>
                    </ToggleButton>
                </Border>

                <Popup IsOpen="{Binding IsPopupOpen, Mode=TwoWay}" StaysOpen="False"
                       Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade">
                    <!-- A Grid with an explicit Auto/* row split, and exactly one MaxHeight (on the
                         ScrollViewer, not also on the Border around it), rather than the DockPanel +
                         two nested MaxHeights this used to be. Popup content sits outside the normal
                         layout flow, and stacking two independent height caps at different levels
                         inside it is an unreliable way to get a scrollable list - measure/arrange can
                         settle on a size that clips items below the fold without the ScrollViewer
                         actually enabling its scrollbar, which read as "some values are just missing"
                         even though RebuildOptions had computed the full list correctly. -->
                    <Border Background="White" BorderBrush="#BDC3C7" BorderThickness="1"
                            CornerRadius="4" Padding="8" MinWidth="180">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                <Button Content="Select all" Padding="6,2" Margin="0,0,6,0"
                                        Command="{Binding SelectAllCommand}"/>
                                <Button Content="Clear" Padding="6,2"
                                        Command="{Binding ClearAllCommand}"/>
                            </StackPanel>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="280"
                                          CanContentScroll="False">
                                <ItemsControl ItemsSource="{Binding Options}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding DisplayText}"
                                                      IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                      Margin="2" Padding="4,0,0,0"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Popup>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Section -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="20,15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Top Row: Title and Auth -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Image Source="/DigitalMIDP;component/Assets/Icons/icon.png"
                               Width="32" Height="32" Stretch="Uniform" VerticalAlignment="Center"
                               Margin="0,0,10,0" ToolTip="Digital MIDP"/>
                        <TextBlock Text="Digital MIDP" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        <TextBlock Text=" | Autodesk Forma File Browser" FontSize="14" Foreground="#BDC3C7" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Authentication Status -->
                        <Border Background="#ECF0F1" Padding="10,8" CornerRadius="4" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <!-- Authenticating Indicator -->
                                <TextBlock FontFamily="Segoe UI Symbol" Text="⟳ Authenticating..." Foreground="#3498DB" FontSize="12" 
                                           Visibility="{Binding IsAuthenticating, Converter={StaticResource BoolToVis}}"/>
                                
                                <!-- Authenticated Status -->
                                <StackPanel Orientation="Horizontal" 
                                            Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVis}}">
                                    <TextBlock FontFamily="Segoe UI Symbol" Text="✓ " Foreground="#27AE60" FontSize="12"/>
                                    <TextBlock Text="Connected" Foreground="#27AE60" FontSize="12" FontWeight="Bold"/>
                                </StackPanel>
                                
                                <!-- Not Authenticated Status -->
                                <TextBlock FontFamily="Segoe UI Symbol" Text="⚠ Not Authenticated" Foreground="#E67E22" FontSize="12"
                                           Visibility="{Binding IsAuthenticated, Converter={StaticResource InverseBoolToVis}}"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- Authentication Buttons -->
                        <Button Content="Authenticate" 
                                Command="{Binding AuthenticateCommand}"
                                IsEnabled="{Binding IsAuthenticating, Converter={StaticResource InverseBool}}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="0,0,10,0"
                                Visibility="{Binding IsAuthenticated, Converter={StaticResource InverseBoolToVis}}"/>
                        
                        <Button Content="Logout" 
                                Command="{Binding LogoutCommand}"
                                Style="{StaticResource DangerButtonStyle}"
                                Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Grid>

                <!-- Bottom Row: Hub and Project Selection -->
                <Grid Grid.Row="1" IsEnabled="{Binding IsAuthenticated}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Hub Selection -->
                    <TextBlock Grid.Column="0" Text="Hub:" FontSize="12" Foreground="#ECF0F1" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding HubSelectionViewModel.Hubs}"
                              SelectedItem="{Binding HubSelectionViewModel.SelectedHub, Mode=TwoWay}"
                              DisplayMemberPath="Name"
                              Height="28"
                              VerticalAlignment="Center">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>

                    <!-- Project Selection -->
                    <TextBlock Grid.Column="3" Text="Project:" FontSize="12" Foreground="#ECF0F1" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox Grid.Column="4"
                              ItemsSource="{Binding ProjectSelectionViewModel.Projects}"
                              SelectedItem="{Binding ProjectSelectionViewModel.SelectedProject, Mode=TwoWay}"
                              DisplayMemberPath="Name"
                              Height="28"
                              VerticalAlignment="Center"
                              IsEnabled="{Binding HubSelectionViewModel.SelectedHub, Converter={StaticResource NullToVis}}">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>

                    <!-- Loading/Error Indicators -->
                    <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                        <!-- Hub Count -->
                        <Border Background="#ECF0F1" Padding="8,6" CornerRadius="3" Margin="0,0,5,0"
                                Visibility="{Binding HubSelectionViewModel.Hubs.Count, Converter={StaticResource NullToVis}}">
                            <TextBlock FontSize="11" Foreground="#34495E">
                                <Run Text="Hubs: "/>
                                <Run Text="{Binding HubSelectionViewModel.Hubs.Count, Mode=OneWay}" FontWeight="Bold"/>
                            </TextBlock>
                        </Border>

                        <!-- Project Count -->
                        <Border Background="#ECF0F1" Padding="8,6" CornerRadius="3" Margin="0,0,5,0"
                                Visibility="{Binding ProjectSelectionViewModel.Projects.Count, Converter={StaticResource NullToVis}}">
                            <TextBlock FontSize="11" Foreground="#34495E">
                                <Run Text="Projects: "/>
                                <Run Text="{Binding ProjectSelectionViewModel.Projects.Count, Mode=OneWay}" FontWeight="Bold"/>
                            </TextBlock>
                        </Border>

                        <!-- Hub Loading -->
                        <Border Background="#ECF0F1" Padding="8,6" CornerRadius="3" Margin="0,0,5,0"
                                Visibility="{Binding HubSelectionViewModel.IsLoading, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Loading hubs..." FontSize="11" Foreground="#3498DB"/>
                        </Border>
                        
                        <!-- Project Loading -->
                        <Border Background="#ECF0F1" Padding="8,6" CornerRadius="3" Margin="0,0,5,0"
                                Visibility="{Binding ProjectSelectionViewModel.IsLoading, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Loading projects..." FontSize="11" Foreground="#3498DB"/>
                        </Border>

                        <!-- Hub Error -->
                        <Border Background="#E74C3C" Padding="8,6" CornerRadius="3" Margin="0,0,5,0"
                                Visibility="{Binding HubSelectionViewModel.ErrorMessage, Converter={StaticResource NullToVis}}"
                                ToolTip="{Binding HubSelectionViewModel.ErrorMessage}"
                                Cursor="Help">
                            <TextBlock FontSize="11" Foreground="White">
                                <Run Text="Hub error: "/>
                                <Run Text="{Binding HubSelectionViewModel.ErrorMessage, Mode=OneWay}"/>
                            </TextBlock>
                        </Border>

                        <!-- Project Error -->
                        <Border Background="#E74C3C" Padding="8,6" CornerRadius="3"
                                Visibility="{Binding ProjectSelectionViewModel.ErrorMessage, Converter={StaticResource NullToVis}}"
                                ToolTip="{Binding ProjectSelectionViewModel.ErrorMessage}">
                            <TextBlock Text="Project error" FontSize="11" Foreground="White"/>
                        </Border>

                        <!-- Desktop Connector not installed -->
                        <Border Background="#95A5A6" Padding="8,6" CornerRadius="3" Margin="5,0,0,0"
                                Visibility="{Binding FilesViewModel.IsDesktopConnectorAvailable, Converter={StaticResource InverseBoolToVis}}"
                                ToolTip="Autodesk Desktop Connector is not installed or not detected on this machine.">
                            <TextBlock Text="Desktop Connector not installed" FontSize="11" Foreground="White"/>
                        </Border>

                        <!-- Project sync status (shown once Desktop Connector is installed) -->
                        <Border Background="{Binding FilesViewModel.SyncedProjectStatus.Status, Converter={StaticResource SyncStatusToBrush}}"
                                Padding="8,6" CornerRadius="3" Margin="5,0,0,0"
                                Visibility="{Binding FilesViewModel.IsDesktopConnectorAvailable, Converter={StaticResource BoolToVis}}"
                                ToolTip="{Binding FilesViewModel.SyncedProjectStatus, Converter={StaticResource SyncedProjectToTooltip}}">
                            <TextBlock Text="{Binding FilesViewModel.SyncedProjectStatus.Status, Converter={StaticResource SyncStatusToText}}"
                                       FontSize="11" Foreground="White" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1" Margin="20">
            <!-- Master-Detail Layout: DataGrid + Details Panel -->
            <Border Background="White" CornerRadius="4" Padding="15">
                <Grid IsEnabled="{Binding IsAuthenticated}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- File Browser Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Searches by file name or Title, across every folder already loaded into
                             the grid - not a server-side search, since all project files are already
                             fetched into Items by the time this box is used. Magnifying glass and the
                             "✕" clear button both sit inside the box itself, as overlays on a Grid
                             rather than siblings in a StackPanel, so they read as part of the search
                             field instead of separate controls next to it. -->
                        <Grid Grid.Column="0" VerticalAlignment="Center" Width="250" HorizontalAlignment="Left">
                            <TextBox Text="{Binding FilesViewModel.FileFilterViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="22,6,22,6"
                                     ToolTip="Search by file name or title"/>
                            <TextBlock Text="&#128269;" FontSize="12" Foreground="#95A5A6"
                                       Margin="6,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                            <Button Content="&#10005;" FontSize="10" Width="18" Height="18" Padding="0"
                                    HorizontalAlignment="Right" Margin="0,0,4,0" VerticalAlignment="Center"
                                    Background="Transparent" BorderThickness="0" Foreground="#95A5A6"
                                    Command="{Binding FilesViewModel.FileFilterViewModel.ClearSearchCommand}"
                                    Visibility="{Binding FilesViewModel.FileFilterViewModel.SearchText, Converter={StaticResource StringNotEmptyToVis}}"
                                    ToolTip="Clear search"/>
                        </Grid>

                        <Button Content="✕ Clear Filters"
                                Grid.Column="1"
                                Padding="10,5"
                                Margin="0,0,10,0"
                                Command="{Binding FilesViewModel.FileFilterViewModel.ClearAllFiltersCommand}"
                                Visibility="{Binding FilesViewModel.FileFilterViewModel.HasActiveFilters, Converter={StaticResource BoolToVis}}"
                                ToolTip="Clear the search box and every column filter"/>

                        <Button x:Name="NewDeliverableButton"
                                Content="➕ New Deliverable"
                                Grid.Column="2"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Padding="10,5"
                                Margin="0,0,5,0"
                                ToolTip="Create a new deliverable from a template, with a unique document number"
                                IsEnabled="{Binding FilesViewModel.IsCreatingDeliverables, Converter={StaticResource InverseBool}}"
                                Click="NewDeliverableButton_Click"/>

                        <Button Content="🔄 Refresh Data"
                                Grid.Column="3"
                                Command="{Binding FilesViewModel.LoadFolderItemsCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Padding="10,5"
                                Margin="0,0,5,0"/>

                        <Button x:Name="ColumnsButton"
                                Content="⚙ Columns"
                                Grid.Column="4"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Padding="10,5"
                                Margin="0"
                                Click="ColumnsButton_Click">
                            <Button.ContextMenu>
                                <ContextMenu x:Name="ColumnSelectorMenu"
                                             Placement="Bottom"
                                             StaysOpen="True">
                                    <!-- HorizontalContentAlignment/VerticalContentAlignment are set explicitly
                                         (as a plain local value, not a Style) on every MenuItem below, and on
                                         each one created in RefreshColumnSelectorMenu's code-behind, because
                                         a ContextMenu opens in its own popup disconnected from the owning
                                         Button's visual tree - the default theme style's
                                         RelativeSource FindAncestor(ItemsControl) binding for these two
                                         properties can't find an ancestor there, which logs a harmless but
                                         noisy binding error for every item in this menu. A local value on the
                                         item itself has higher precedence than that style setter, so it wins
                                         outright and the broken binding is never evaluated. (An
                                         ItemContainerStyle setter was tried first but does not apply here,
                                         since these MenuItems are declared directly rather than generated
                                         from an ItemsSource.) -->
                                    <MenuItem Header="Select Columns" IsEnabled="False" FontWeight="Bold"
                                              HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"/>
                                    <Separator/>
                                    <MenuItem Header="Name" IsCheckable="True"
                                              IsChecked="{Binding FilesViewModel.ColumnSelectorViewModel.IsNameColumnVisible, Mode=TwoWay}"
                                              StaysOpenOnClick="True"
                                              HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"/>
                                    <MenuItem Header="Deliverable Title" IsCheckable="True"
                                              IsChecked="{Binding FilesViewModel.ColumnSelectorViewModel.IsTypeColumnVisible, Mode=TwoWay}"
                                              StaysOpenOnClick="True"
                                              HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"/>
                                    <MenuItem Header="Stage" IsCheckable="True"
                                              IsChecked="{Binding FilesViewModel.ColumnSelectorViewModel.IsStageColumnVisible, Mode=TwoWay}"
                                              StaysOpenOnClick="True"
                                              HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"/>
                                    <MenuItem Header="Status" IsCheckable="True"
                                              IsChecked="{Binding FilesViewModel.ColumnSelectorViewModel.IsStatusColumnVisible, Mode=TwoWay}"
                                              StaysOpenOnClick="True"
                                              HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"/>
                                    <MenuItem Header="Revision" IsCheckable="True"
                                              IsChecked="{Binding FilesViewModel.ColumnSelectorViewModel.IsRevisionColumnVisible, Mode=TwoWay}"
                                              StaysOpenOnClick="True"
                                              HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"/>
                                    <MenuItem Header="Path in Project" IsCheckable="True"
                                              IsChecked="{Binding FilesViewModel.ColumnSelectorViewModel.IsLocationColumnVisible, Mode=TwoWay}"
                                              StaysOpenOnClick="True"
                                              HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"/>
                                    <Separator x:Name="CustomAttributesSeparator" Visibility="Collapsed"/>
                                    <!-- Custom attribute menu items will be added dynamically here -->
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </Grid>
                    
                    <!-- Loading Indicator, plus background deliverable-creation status. Stacked in one
                         panel rather than each pinned to Grid.Row="1" directly, so they lay out one
                         above the other instead of overlapping. -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,10">
                        <!-- Loading a project is the longest operation in the application (a recursive
                             folder walk, then a path lookup per file, then the attribute batch), so it
                             is cancellable - previously a user who picked the wrong project could only
                             wait for it to finish. -->
                        <StackPanel Visibility="{Binding FilesViewModel.IsLoading, Converter={StaticResource BoolToVis}}">
                            <ProgressBar IsIndeterminate="True" Height="4"/>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding FilesViewModel.LoadingStatusText}"
                                           FontSize="11" Foreground="#7F8C8D" VerticalAlignment="Center"
                                           Visibility="{Binding FilesViewModel.LoadingStatusText, Converter={StaticResource NullToVis}}"/>

                                <Button Grid.Column="1" Padding="10,2" Margin="10,0,0,0"
                                        FontSize="11" VerticalAlignment="Center"
                                        Command="{Binding FilesViewModel.CancelLoadCommand}"
                                        IsEnabled="{Binding FilesViewModel.IsCancellingLoad, Converter={StaticResource InverseBool}}"
                                        ToolTip="Stop loading this project. Files already loaded are kept.">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Content" Value="Cancel"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FilesViewModel.IsCancellingLoad}" Value="True">
                                                    <Setter Property="Content" Value="Cancelling..."/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- Brief "Path/Link copied to clipboard" confirmation after the Copy Path/Copy
                             Link context menu actions - auto-clears itself (FilesViewModel.ShowClipboardStatus),
                             so unlike the banners below it, this one is never manually dismissed. -->
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                    Visibility="{Binding FilesViewModel.ClipboardStatusText, Converter={StaticResource NullToVis}}">
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#27AE60"/>
                            <TextBlock Text="{Binding FilesViewModel.ClipboardStatusText}"
                                       FontSize="11" Foreground="#27AE60" Margin="5,0,0,0"/>
                        </StackPanel>

                        <!-- Shown while a New Deliverable batch is running in the background. The
                             wizard dialog itself already closed by this point (see
                             MainWindow.NewDeliverableButton_Click) - this is the user's only view into
                             the batch's progress, and the rest of the app stays fully usable while it
                             is visible. -->
                        <Border Background="#EAF2F8" Padding="10" CornerRadius="4" Margin="0,8,0,0"
                                Visibility="{Binding FilesViewModel.IsCreatingDeliverables, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding FilesViewModel.DeliverableCreationStatusText}"
                                               Foreground="#2980B9" FontSize="12" TextWrapping="Wrap"/>
                                    <!-- Switches to an animated indeterminate bar while cancelling -
                                         there is no longer a meaningful "N of M" to show a determinate
                                         value for, and the motion itself is the "this is happening"
                                         signal the Cancel click needs. -->
                                    <ProgressBar Height="6" Margin="0,6,0,0"
                                                 Minimum="0"
                                                 Maximum="{Binding FilesViewModel.DeliverableCreationTotal}"
                                                 Value="{Binding FilesViewModel.DeliverableCreationCompleted, Mode=OneWay}"
                                                 IsIndeterminate="{Binding FilesViewModel.IsCancellingDeliverableCreation}"
                                                 Background="Transparent" BorderThickness="0" Foreground="#3498DB"/>
                                </StackPanel>

                                <Button Grid.Column="1" Padding="10,4" Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        Command="{Binding FilesViewModel.CancelDeliverableCreationCommand}"
                                        IsEnabled="{Binding FilesViewModel.IsCancellingDeliverableCreation, Converter={StaticResource InverseBool}}"
                                        ToolTip="Stop after the document currently being created. Documents already created are kept.">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Content" Value="Cancel"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FilesViewModel.IsCancellingDeliverableCreation}" Value="True">
                                                    <Setter Property="Content" Value="Cancelling..."/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- The batch's final outcome, shown once and left up until dismissed or the
                             next batch starts - not auto-hidden, so a partial-failure summary is not
                             missed by a user who stepped away while it was running. -->
                        <Border Padding="10" CornerRadius="4" Margin="0,8,0,0"
                                Visibility="{Binding FilesViewModel.DeliverableCreationResultMessage, Converter={StaticResource NullToVis}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#D5F5E3"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FilesViewModel.DeliverableCreationHadProblems}" Value="True">
                                            <Setter Property="Background" Value="#FCF3CF"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding FilesViewModel.DeliverableCreationResultMessage}"
                                           FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#1E8449"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FilesViewModel.DeliverableCreationHadProblems}" Value="True">
                                                    <Setter Property="Foreground" Value="#9A7D0A"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <Button Grid.Column="1" Content="✕" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Top"
                                        Command="{Binding FilesViewModel.DismissDeliverableCreationResultCommand}"
                                        ToolTip="Dismiss"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- File/Folder List DataGrid -->
                    <DataGrid x:Name="FilesDataGrid" Grid.Row="2"
                              ItemsSource="{Binding FilesViewModel.ItemsView}"
                              SelectedItem="{Binding FilesViewModel.SelectedItem, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              SelectionMode="Extended"
                              GridLinesVisibility="None"
                              RowHeight="40"
                              PreviewMouseLeftButtonDown="FilesDataGrid_PreviewMouseLeftButtonDown"
                              HeadersVisibility="Column"
                              AlternatingRowBackground="#F9F9F9"
                              HorizontalScrollBarVisibility="Auto"
                              MouseDoubleClick="FilesDataGrid_MouseDoubleClick"
                              ContextMenuOpening="FilesDataGrid_ContextMenuOpening">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="ViewOnWebMenuItem" Header="View on Web" Click="ViewOnWeb_Click"/>
                                <MenuItem x:Name="OpenFileLocationMenuItem" Header="Open File Location" Click="OpenFileLocation_Click"/>
                                <Separator/>
                                <!-- Copy Path/Copy Link kept together as one group - Copy Path only shows for a
                                     synced project (needs a resolved local Desktop Connector path), Copy Link
                                     always shows (only needs the ACC web view link). -->
                                <MenuItem x:Name="CopyPathMenuItem" Header="Copy Path" Click="CopyPath_Click"/>
                                <MenuItem x:Name="CopyLinkMenuItem" Header="Copy Link" Click="CopyLink_Click"/>
                                <Separator/>
                                <MenuItem Header="Edit Attributes..." Click="EditAttributes_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <!-- Name column: 20% width -->
                            <DataGridTemplateColumn Header="Name" Width="2*" MinWidth="200" SortMemberPath="Name">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="5,0,0,0"
                                                   ToolTip="{Binding Name}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Deliverable Title column: 30% width
                                 Header/HeaderTemplate assigned in code-behind (MainWindow.AttachColumnFilterHeaders) -->
                            <DataGridTemplateColumn x:Name="TitleColumn" Width="3*" MinWidth="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding CustomAttributes, Converter={StaticResource CustomAttrValue}, ConverterParameter='Deliverable Title'}" VerticalAlignment="Center" Margin="5,0,0,0"
                                                   ToolTip="{Binding CustomAttributes, Converter={StaticResource CustomAttrValue}, ConverterParameter='Deliverable Title'}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Stage column: 10% width
                                 Header/HeaderTemplate assigned in code-behind -->
                            <DataGridTemplateColumn x:Name="StageColumn" Width="1*" MinWidth="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding LifecycleStage, Converter={StaticResource StageToText}}"
                                                   VerticalAlignment="Center" Margin="5,0,0,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Status column (custom attribute): 10% width
                                 Header/HeaderTemplate assigned in code-behind -->
                            <DataGridTemplateColumn x:Name="StatusColumn" Width="1*" MinWidth="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding CustomAttributes, Converter={StaticResource CustomAttrValue}, ConverterParameter=Status}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Revision column (custom attribute): 10% width
                                 Header/HeaderTemplate assigned in code-behind -->
                            <DataGridTemplateColumn x:Name="RevisionColumn" Width="1*" MinWidth="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding CustomAttributes, Converter={StaticResource CustomAttrValue}, ConverterParameter=Revision}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Path in Project column: 20% width
                                 Header/HeaderTemplate assigned in code-behind -->
                            <DataGridTemplateColumn x:Name="PathInProjectColumn" Width="2*" MinWidth="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding PathInProject}" VerticalAlignment="Center" Margin="5,0,0,0"
                                                   ToolTip="{Binding PathInProject}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                        
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Cursor" Value="Arrow"/>
                                <Setter Property="IsEnabled" Value="True"/>
                                <EventSetter Event="PreviewMouseRightButtonDown" Handler="FilesDataGridRow_PreviewMouseRightButtonDown"/>
                                <Style.Triggers>
                                    <!-- Disable folder rows visually -->
                                    <DataTrigger Binding="{Binding Type}" Value="0">
                                        <Setter Property="Opacity" Value="0.6"/>
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>

                    <!-- Empty State (shown once loading has finished and no files were found) -->
                    <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding FilesViewModel.ShowEmptyState, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="No files found" FontSize="16" FontWeight="SemiBold"
                                   Foreground="#7F8C8D" HorizontalAlignment="Center"/>
                        <TextBlock Text="This project doesn't have any files yet." FontSize="12"
                                   Foreground="#95A5A6" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Error Message Display -->
                    <Border Grid.Row="3" Background="#FADBD8" Padding="10" CornerRadius="4" Margin="0,10,0,0"
                            Visibility="{Binding FilesViewModel.ErrorMessage, Converter={StaticResource NullToVis}}">
                        <TextBlock Text="{Binding FilesViewModel.ErrorMessage}" 
                                   Foreground="#E74C3C" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer Status Bar -->
        <StatusBar Grid.Row="2" Background="#ECF0F1" Padding="15,8">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Status: " FontSize="11" Foreground="#34495E"/>
                    <TextBlock FontSize="11" Foreground="#34495E">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Disconnected"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAuthenticated}" Value="True">
                                        <Setter Property="Text" Value="Connected to APS"/>
                                        <Setter Property="Foreground" Value="#27AE60"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsAuthenticating}" Value="True">
                                        <Setter Property="Text" Value="Authenticating..."/>
                                        <Setter Property="Foreground" Value="#3498DB"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </StatusBarItem>
            
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding FilesViewModel.Items.Count, StringFormat='Items: {0}'}" 
                           FontSize="11" Foreground="#7F8C8D"/>
            </StatusBarItem>
        </StatusBar>
        
        <!-- Authentication Error Overlay -->
        <Border Grid.Row="0" Grid.RowSpan="3" Background="#99000000" 
                Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVis}}">
            <Border Background="White" Padding="30" CornerRadius="8" MaxWidth="400" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Authentication Error" FontSize="18" FontWeight="Bold" Foreground="#E74C3C" Margin="0,0,0,15" TextAlignment="Center"/>
                    <TextBlock Text="{Binding ErrorMessage}" FontSize="12" Foreground="#34495E" TextWrapping="Wrap" Margin="0,0,0,20"/>
                    <Button Content="Try Again" 
                            Command="{Binding AuthenticateCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
