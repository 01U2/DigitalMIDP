<!--<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Id="TODO_Manufacturer.DigitalMIDP.Installer" Name="DigitalMIDP.Installer" Manufacturer="TODO Manufacturer" Version="1.0.0">
    <MajorUpgrade DowngradeErrorMessage="!(loc.DowngradeError)" />

    <Feature Id="Main">
      <ComponentGroupRef Id="ExampleComponents" />
    </Feature>
  </Package>
</Wix>-->


<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:netfx="http://wixtoolset.org/schemas/v4/wxs/netfx">

	<Package Name="DigitalMIDP"
			 Manufacturer="01U2"
			 Version="$(var.ProductVersion)"
			 UpgradeCode="978D8E3F-C2F5-40C0-87BB-82892FF30A67"
			 Scope="perUser">

		<MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
		<MediaTemplate EmbedCab="yes" />

		<!-- Blocks install when the .NET 8 Desktop Runtime (x64) is missing. -->
		<netfx:DotNetCompatibilityCheck Property="DOTNETDESKTOP8"
										RollForward="latestMinor"
										RuntimeType="desktop"
										Platform="x64"
										Version="8.0.0" />
		<Launch Condition="Installed OR DOTNETDESKTOP8=&quot;0&quot;"
				Message="DigitalMIDP requires the .NET 8 Desktop Runtime (x64). Install it from https://dotnet.microsoft.com/download/dotnet/8.0 and run setup again." />

		<Icon Id="AppIcon" SourceFile="..\DigitalMIDP\Assets\Icons\icon.ico" />
		<Property Id="ARPPRODUCTICON" Value="AppIcon" />

		<!-- %LOCALAPPDATA%\Programs\DigitalMIDP (user-writable, no elevation) -->
		<StandardDirectory Id="LocalAppDataFolder">
			<Directory Id="ProgramsFolder" Name="Programs">
				<Directory Id="INSTALLFOLDER" Name="DigitalMIDP">
					<Directory Id="RUNNERFOLDER" Name="ManifestRunner" />
				</Directory>
			</Directory>
		</StandardDirectory>

		<StandardDirectory Id="ProgramMenuFolder">
			<Directory Id="AppMenuFolder" Name="DigitalMIDP" />
		</StandardDirectory>

		<Property Id="INSTALLLEVEL" Value="1" />
		<Feature Id="Main" Title="DigitalMIDP client" Level="1" AllowAbsent="no" AllowAdvertise="no" ConfigurableDirectory="INSTALLFOLDER">
			<ComponentGroupRef Id="AppFiles" />
			<ComponentRef Id="InstallFolderCleanup" />
			<ComponentRef Id="StartMenuShortcut" />
		</Feature>
		<Feature Id="ManifestRunner" Title="Manifest Runner" Description="Install the manifest publishing application and its Start Menu shortcut." Level="2" AllowAdvertise="no">
			<ComponentGroupRef Id="RunnerFiles" />
			<ComponentRef Id="RunnerShortcut" />
		</Feature>

		<!-- License agreement page -->
		<WixVariable Id="WixUILicenseRtf" Value="Data\UserAgreement.rtf" />

		<ui:WixUI Id="WixUI_FeatureTree" />
	</Package>

	<Fragment>
		<ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
			<Component>
				<File Id="MainExe" Source="$(var.ClientPublish)\DigitalMIDP.exe" KeyPath="yes" />
			</Component>
			<Files Include="$(var.ClientPublish)\**">
				<Exclude Files="$(var.ClientPublish)\DigitalMIDP.exe" />
				<Exclude Files="$(var.ClientPublish)\**\*.pdb" />
			</Files>
		</ComponentGroup>
		<ComponentGroup Id="RunnerFiles" Directory="RUNNERFOLDER">
			<Files Include="$(var.RunnerPublish)\**">
				<Exclude Files="$(var.RunnerPublish)\**\*.pdb" />
			</Files>
		</ComponentGroup>
		<Component Id="RunnerShortcut" Directory="AppMenuFolder">
			<Shortcut Name="DigitalMIDP Manifest Runner" Target="[RUNNERFOLDER]DigitalMIDP.ManifestRunner.exe" WorkingDirectory="RUNNERFOLDER" Icon="AppIcon" />
			<RemoveFolder Id="RemoveRunnerFolder" Directory="RUNNERFOLDER" On="uninstall" />
			<RegistryValue Root="HKCU" Key="Software\01U2\DigitalMIDP" Name="runnerInstalled" Type="integer" Value="1" KeyPath="yes" />
		</Component>

		<!-- Removes the per-user install folder on uninstall -->
		<Component Id="InstallFolderCleanup" Directory="INSTALLFOLDER">
			<RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
			<RegistryValue Root="HKCU" Key="Software\01U2\DigitalMIDP"
						   Name="installdir" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
		</Component>

		<Component Id="StartMenuShortcut" Directory="AppMenuFolder">
			<Shortcut Name="DigitalMIDP"
					  Target="[INSTALLFOLDER]DigitalMIDP.exe"
					  WorkingDirectory="INSTALLFOLDER"
					  Icon="AppIcon" />
			<RemoveFolder Id="RemoveAppMenuFolder" On="uninstall" />
			<RegistryValue Root="HKCU" Key="Software\01U2\DigitalMIDP"
						   Name="installed" Type="integer" Value="1" KeyPath="yes" />
		</Component>
	</Fragment>

</Wix>