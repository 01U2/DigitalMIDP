<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windows-only: this layer reads Autodesk Desktop Connector's state out of the Windows
         registry and protects stored tokens with Windows DPAPI. Targeting net8.0-windows is what
         makes the platform-compatibility analyser verify those calls instead of warning that they
         are "reachable on all platforms" (CA1416). See Directory.Build.props. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DigitalMIDP.Application\DigitalMIDP.Application.csproj" />
    <ProjectReference Include="..\DigitalMIDP.Domain\DigitalMIDP.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DigitalMIDP.Tests" />
    <!-- Lets NSubstitute/Castle DynamicProxy create ILogger<DataManagementService> substitutes,
         since DataManagementService is internal and Microsoft.Extensions.Logging.Abstractions is
         strong-named. -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2, " />
    <!-- And the UNSIGNED proxy assembly, which is the one Castle emits when substituting an
         internal interface declared in this (not strong-named) assembly - e.g. IApsMetadataCache or
         ITokenProtector. Without it those substitutes fail at run time with "attempting to implement
         an inaccessible interface", because the entry above only grants access to the signed one. -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Autodesk.DataManagement" Version="2.1.3" />
    <PackageReference Include="Autodesk.SDKManager" Version="1.1.2" />
    <PackageReference Include="System.Net.Http.Json" Version="10.0.3" />
    <!-- Retry/backoff for transient APS failures - see Http/ApsResilienceHandler.cs. -->
    <PackageReference Include="Polly" Version="8.5.0" />
    <!-- Windows DPAPI, used to keep the OAuth refresh token encrypted while it is held in memory
         (Authentication/DpapiTokenProtector.cs). -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.3" />
  </ItemGroup>

	
</Project>
